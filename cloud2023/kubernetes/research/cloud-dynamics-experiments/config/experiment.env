# Cloud Dynamics controlled experiment configuration.
# Defaults are local and portable.
# Export HOST_IP before running to target another reachable cluster, e.g.:
#   export HOST_IP=10.160.4.43
#
# Exported environment variables take precedence in the runner.
HOST_IP=127.0.0.1
HOST_IP=10.160.4.43
TARGET_SCHEME=http
TARGET_HOST=
TARGET_PATH=/
TARGET_URL="http://database-api.${HOST_IP}.sslip.io/"

REQUEST_TIMEOUT=5
WARMUP_SECONDS=30
WARMUP_RPS=5
COOLDOWN_SECONDS=15
SAMPLE_INTERVAL=1

APPLICATION_NAME=database-api
APPLICATION_ARCHITECTURE=database

REPLICAS=2

CPU_REQUEST=100m
CPU_LIMIT=500m

MEMORY_REQUEST=64Mi
MEMORY_LIMIT=256Mi
