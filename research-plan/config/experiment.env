# Cloud Dynamics SocialNetwork Experiment Configuration
#
# MODE REMOTE (default): klaster Kubernetes berada di mesin lain.
#   HOST_IP adalah IP mesin klaster. App & Prometheus terjangkau via ingress:
#     http://social-network.<HOST_IP>.sslip.io
#     http://prometheus.<HOST_IP>.sslip.io
#   Override sementara:  export HOST_IP=<ip-lain>
#
# MODE LOCAL:  export HOST_IP=127.0.0.1
#
HOST_IP=10.160.4.43
NAMESPACE="cloud-dynamics"

TARGET_SCHEME="http"
TARGET_HOST="social-network.${HOST_IP}.sslip.io"
TARGET_URL="${TARGET_SCHEME}://${TARGET_HOST}"

REQUEST_TIMEOUT=5
WARMUP_SECONDS=10
WARMUP_RPS=5
COOLDOWN_SECONDS=10
SAMPLE_INTERVAL=1

APPLICATION_NAME="social-network"
APPLICATION_ARCHITECTURE="microservices-deathstarbench"
# ponytail: 50 users for fast homelab seeding; upgrade path is 962 for full socfb-Reed98
MAX_USER_INDEX=50
